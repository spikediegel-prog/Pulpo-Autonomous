<?xml version="1.0"?>
<sdf version="1.9">
  <world name="pulpo_disposable">
    <physics name="step" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <gravity>0 0 -9.8</gravity>
    <model name="ground">
      <static>true</static>
      <link name="ground"><collision name="ground"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision></link>
    </model>
    <model name="pulpo_disposable">
      <pose>0 0 0.21 0 0 0</pose>
      <link name="chassis">
        <inertial><mass>1</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia></inertial>
        <collision name="body"><geometry><box><size>0.4 0.3 0.1</size></box></geometry></collision>
      </link>
      <link name="left">
        <pose>0 0.2 -0.1 1.57079632679 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
        <collision name="wheel"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></collision>
      </link>
      <link name="right">
        <pose>0 -0.2 -0.1 1.57079632679 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
        <collision name="wheel"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></collision>
      </link>
      <link name="caster">
        <pose>-0.15 0 -0.15 0 0 0</pose>
        <inertial><mass>0.01</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="ball"><geometry><sphere><radius>0.05</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
      </link>
      <joint name="left_joint" type="revolute"><parent>chassis</parent><child>left</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <joint name="right_joint" type="revolute"><parent>chassis</parent><child>right</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <joint name="caster_joint" type="fixed"><parent>chassis</parent><child>caster</child></joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_joint</left_joint><right_joint>right_joint</right_joint>
        <wheel_separation>0.4</wheel_separation><wheel_radius>0.1</wheel_radius>
        <topic>/pulpo_sim/cmd_vel</topic><odom_topic>/pulpo_sim/odom</odom_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
